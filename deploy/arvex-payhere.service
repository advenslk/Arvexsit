[Unit]
Description=ArveX PayHere Payment Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/arvex
EnvironmentFile=/var/www/arvex/.env
ExecStart=/usr/bin/node /var/www/arvex/payhere-server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/arvex/data

[Install]
WantedBy=multi-user.target
