# Gemini / AI configuration
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public application URL
APP_URL="https://arvex.host"

# Admin gate used by the Vite build.
# Do NOT commit the real values. Put them in the VPS .env file before building.
VITE_ADMIN_EMAIL="admin@your-domain.example"
VITE_ADMIN_PASSWORD="CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD"
