# Optional public AI configuration
GEMINI_API_KEY=""
APP_URL="https://arvex.host"

# Server-only administrator credentials. Never use VITE_ for these values.
PORT=5000
PUBLIC_ORIGIN="https://arvex.host"
ADMIN_EMAIL="admin@arvex.host"
ADMIN_PASSWORD="CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD"
ADMIN_TOKEN_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_64_CHARS"

# Google OAuth / OpenID Connect
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://arvex.host/api/auth/google/callback"

# Email verification for password accounts (Resend REST API)
RESEND_API_KEY=""
RESEND_FROM="ArveX Hosting <noreply@arvex.host>"

# PayHere server-only credentials. NEVER expose PAYHERE_MERCHANT_SECRET to Vite/client code.
PAYHERE_MERCHANT_ID=""
PAYHERE_MERCHANT_SECRET=""
PAYHERE_SANDBOX="true"
PAYHERE_PORT=5001
INTERNAL_API_ORIGIN="http://127.0.0.1:5000"
# Rate used to convert the plan's USD price into LKR for PayHere checkout.
# Keep this server-side and update it when your pricing policy changes.
PAYHERE_USD_TO_LKR=300
